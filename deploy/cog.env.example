# Red cog env: copy into Red's service environment (EnvironmentFile= in the
# Red systemd unit). Downloader does not load .env from the cog directory.
#
# No DISCORD_BOT_TOKEN belongs here either. Red handles Discord auth.
# LLM_API_KEY is the bearer key for the gamoaibot Hermes API:
# it must match API_SERVER_KEY in the Hermes profile's .env.

# --- Cog -> Hermes profile API server (chat) ---
# Point this at your Hermes host. With a multiplexed gateway, include the
# /p/<profile>/v1 prefix; with a standalone server, use its base URL.
LLM_ENDPOINT=http://<HERMES_HOST>:8642/p/gamoaibot/v1
LLM_API_KEY=replace-with-the-profile-API_SERVER_KEY
LLM_MODEL=gamoaibot

# --- Optional separate multimodal endpoint/model ---
# Blank means "use the LLM_* counterpart". Any OpenAI-compatible vision
# endpoint works. Messages with inline images go here directly, so they do
# NOT pass through the Hermes agent loop or its video tools.
VISION_ENDPOINT=
VISION_API_KEY=
VISION_MODEL=

# --- Cog -> Hindsight REST (the cog owns all memory banks) ---
HINDSIGHT_API_URL=http://<HINDSIGHT_HOST>:8888
HINDSIGHT_API_KEY=replace-with-hindsight-key
HINDSIGHT_TIMEOUT=30

# --- Media cache ---
MEDIA_CACHE_DIR=./runtime/media-cache
MEDIA_MAX_BYTES=20971520

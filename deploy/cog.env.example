# Red cog env: copy into Red's service environment (EnvironmentFile= in the
# Red systemd unit). Downloader does not load .env from the cog directory.
#
# No DISCORD_BOT_TOKEN belongs here either. Red handles Discord auth.
# LLM_API_KEY is the bearer key for the gamoaibot profile's loopback API:
# it must match API_SERVER_KEY in the profile's .env.

# --- Cog -> Hermes profile API server (chat) ---
# Production (cog in <INTERNAL_HOST>) and a test Red on this host both use the
# multiplexed gateway: one process serves every profile on port 8642, with the
# profile selected by the /p/<profile> prefix and its own API_SERVER_KEY.
LLM_ENDPOINT=http://<LAN_IP>:8642/p/gamoaibot/v1
LLM_API_KEY=replace-with-the-profile-API_SERVER_KEY
LLM_MODEL=gamoaibot

# --- Optional separate multimodal endpoint/model ---
# Blank means "use the LLM_* counterpart". Verified local vision server:
VISION_ENDPOINT=http://<VISION_HOST>:8080/v1
VISION_API_KEY=not-needed
VISION_MODEL=<VISION_MODEL>
# NOTE: messages with inline images go to this endpoint directly, so they do
# NOT run through the Hermes agent loop (no tools, no video_analyze). Chat-only
# turns still go to the gamoaibot profile.

# --- Cog -> Hindsight REST (the cog owns all memory banks) ---
HINDSIGHT_API_URL=http://<INTERNAL_HOST>:8888
HINDSIGHT_API_KEY=replace-with-hindsight-key
HINDSIGHT_TIMEOUT=30

# --- Media cache ---
MEDIA_CACHE_DIR=/var/lib/redbot/gamoai/media-cache
MEDIA_MAX_BYTES=20971520

# Hermes profile: ~/.hermes/profiles/gamoaibot/.env
#
# This profile is NOT a Discord gateway. No DISCORD_BOT_TOKEN belongs here.
# It is reached by the Red cog through the Hermes API, using API_SERVER_KEY.
# Generate the key with: openssl rand -hex 32
# The cog's LLM_API_KEY must be the SAME value.

API_SERVER_ENABLED=true
# Bind address for a standalone API server. Hermes 0.23 may instead run one
# multiplexed gateway for all profiles; in that case the profile is reached at
# /p/<profile>/v1 on the gateway port and this value is only a fallback.
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8643
API_SERVER_KEY=replace-with-openssl-rand-hex-32

# No LLM provider key here unless you deliberately change this profile's model.
# Configure provider/model with `hermes -p gamoaibot model` (or config set).
# Do not paste tokens in chat.

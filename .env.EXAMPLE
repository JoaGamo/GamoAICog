# Copy to the profile's .env (Hermes side) and/or to cog/.env (Red side).
# No real values here. Fill them in locally; .env is gitignored.
#
# WHICH FILE:
#   ~/.hermes/profiles/gamoaibot/.env  -> API_SERVER_ENABLED/HOST/PORT/KEY
#   cog/.env (Red host)                -> LLM_*, VISION_*, HINDSIGHT_*, MEDIA_*
# The API_SERVER_KEY from the profile is the SAME value as LLM_API_KEY in cog/.env.
# It is a bearer key for the loopback Hermes API, NOT an LLM provider key and NOT a URL.

# --- Hermes profile: loopback OpenAI-compatible API server ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8643
API_SERVER_KEY=replace-with-long-random-key

# --- Cog -> Hermes (chat) ---
LLM_ENDPOINT=http://127.0.0.1:8643/v1
LLM_API_KEY=replace-with-the-same-API_SERVER_KEY
LLM_MODEL=gamoaibot

# --- Cog -> Hermes (vision): blank means "use the LLM_* value" ---
VISION_ENDPOINT=
VISION_API_KEY=
VISION_MODEL=

# --- Cog -> Hindsight REST ---
HINDSIGHT_API_URL=http://<INTERNAL_HOST>:8888
HINDSIGHT_API_KEY=replace-with-hindsight-key
HINDSIGHT_TIMEOUT=30

# --- Cog media cache ---
MEDIA_CACHE_DIR=<LOCAL_HOME>/GamoAICog/runtime/media-cache
MEDIA_MAX_BYTES=20971520
